# Contact form delivery (POST /api/contact).
# Set these in Vercel: Project > Settings > Environment Variables.
# Without RESEND_API_KEY the route returns 503 and the form falls back to
# opening the reader's mail client with their message already filled in.

# Required. From https://resend.com > API Keys.
RESEND_API_KEY=

# Optional. Where enquiries land. Defaults to CONTACT.emails[0] in src/lib/content.ts
CONTACT_TO=support@cybaethrex.com

# Optional. The envelope sender. Must be on a domain verified in Resend.
# The default below is Resend's sandbox sender, which can only deliver to the
# address the Resend account was registered with. Once cybaethrex.com is
# verified, change this to something like: Cybaethrex <website@cybaethrex.com>
CONTACT_FROM=Cybaethrex Website <onboarding@resend.dev>
