# Contact form delivery (POST /api/contact).
# Set these in Vercel: Project > Settings > Environment Variables.
#
# Pick ONE of the three routes below. They are tried in this order, so a
# webhook wins over a Google Form, which wins over Resend.
#
# With none of them set the route returns 503 and the form falls back to
# opening the reader's mail client with their message already filled in.
# Nothing is ever lost.

# Where enquiries land. Optional: defaults to CONTACT.emails[0] in
# src/lib/content.ts, which is support@cybaethrex.com.
CONTACT_TO=support@cybaethrex.com


# --- 1. Webhook: Google Apps Script, Zapier, Make, n8n, your own endpoint ---
# Recommended for Google. Produces a real email with the sender in Reply-To,
# and costs nothing. Full setup lives in docs/contact-apps-script.gs
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=


# --- 2. Google Form: responses collect in a Sheet -------------------------
# The form's POST target. Open the live form, view source, and take the
# action attribute. It ends in /formResponse
GOOGLE_FORM_ACTION=
# Map our field names to that form's entry ids, as JSON on one line. Find the
# ids in the same page source, they look like entry.1234567890
GOOGLE_FORM_FIELDS={"name":"entry.0","email":"entry.0","company":"entry.0","engagement":"entry.0","context":"entry.0"}


# --- 3. Resend: send email directly through an email API ------------------
RESEND_API_KEY=
# The envelope sender. Must be on a domain verified in Resend. The default
# below is Resend's sandbox sender, which only delivers to the address the
# Resend account was registered with.
CONTACT_FROM=Cybaethrex Website <onboarding@resend.dev>
